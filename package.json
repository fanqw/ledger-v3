{
  "name": "ledger-v3",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev & pnpm --filter server dev",
    "build": "pnpm --filter shared build && pnpm --filter server build && pnpm --filter web build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@nestjs/core",
      "esbuild"
    ],
    "overrides": {
      "@angular-devkit/core>picomatch": "4.0.5",
      "@nestjs/swagger>lodash": "4.18.1",
      "@nestjs/swagger>js-yaml": "4.3.0",
      "external-editor>tmp": "0.2.6",
      "multer": "^2.2.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "cross-env": "7.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.8.0",
    "typescript-eslint": "^8.65.0"
  }
}
