{
  "name": "@ledger-v3/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=true eslint src/",
    "test:security": "node --test scripts/*-security.test.mjs",
    "test": "pnpm run test:security && node --test scripts/effect-performance.test.mjs scripts/ui-layout-contract.test.mjs",
    "verify:e2e": "node e2e/scripts/order-detail.spec.mjs",
    "smoke:e2e": "node e2e/scripts/smoke.spec.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ledger-v3/shared": "workspace:*",
    "antd": "^6.6.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
